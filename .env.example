# ==============================================================================
# JARVIS Desktop Assistant - Environment Configuration
# ==============================================================================

# Server Network Settings (Loopback only for security)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DEBUG=true

# Security & CORS
JARVIS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","tauri://localhost"]
JARVIS_API_KEY_SECRET=change-this-to-a-secure-random-secret-token

# AI Provider Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=45.0
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_INPUT_CHARS=16000
AI_TEMPERATURE=0.7

# Filesystem Sandboxing (Allowed directories for file operations)
JARVIS_WORKSPACE_ROOT=./data/workspace
JARVIS_ALLOWED_PATHS=["./data/workspace"]

# Persistence
JARVIS_DATABASE_URL=sqlite:///./data/jarvis.db

# External Models Storage (Keep heavy voice models outside git repository)
# Default auto-resolves to ../JARVIS_MODELS or ~/.jarvis/models
JARVIS_MODELS_DIR=../JARVIS_MODELS


